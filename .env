# Base de données
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pocket_logistics

# Prisma — connexion complète (utilise les variables ci-dessus)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/pocket_logistics?schema=public

# JWT
JWT_SECRET=your_secret_key_change_this_in_production
JWT_EXPIRATION=7d

# Serveur
PORT=3000
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/pocket_logistics_shadow?schema=public
